#!/usr/bin/env bash
# homebase — distribution CLI for ~/code/homebase
#
# Verbs:
#   link                         Symlink ~/.claude/{agents,skills,statusline-command.sh,agent-signal.sh,settings.json} → homebase
#   link-project <project>       Create project-level symlinks into the given project
#   migrate <project>            Idempotent one-shot: replace vendored copies with symlinks
#   status <project>             Verify every expected symlink in the project points to homebase
#   bootstrap                    First-run on a new machine: link + walk every registered project (SOP-014)
#   sync <project>               DEPRECATED — prints guidance to run link-project / migrate instead
#   register <project>           Add a project to the registry without symlinking
#   index [--check]              Regenerate registry/PROJECTS.md from each project's project.yml
#   list                         Print registry/PROJECTS.md to stdout
#   deploy <app> <env>           Deploy an app via Kamal — 12-phase pipeline (see Rails Playbook)
#   rollback <app> <env>         Roll an app back to a prior version via `kamal rollback`
#   settings <sub>               Manage portable user-level Claude Code settings (HMB-50)
#   roster                       List agents in the staff roster
#   sops                         List canonical SOPs (HOMEBASE-SOP-*)
#   help                         Show this help

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
HOMEBASE="$(cd "$SCRIPT_DIR/.." && pwd)"

# Colour codes (bail to empty if NO_COLOR is set or stdout isn't a tty)
if [[ -n "${NO_COLOR:-}" ]] || [[ ! -t 1 ]]; then
  C_RED="" C_GREEN="" C_YELLOW="" C_BLUE="" C_BOLD="" C_RESET=""
else
  C_RED=$'\033[0;31m'
  C_GREEN=$'\033[0;32m'
  C_YELLOW=$'\033[0;33m'
  C_BLUE=$'\033[0;34m'
  C_BOLD=$'\033[1m'
  C_RESET=$'\033[0m'
fi

err()   { echo "${C_RED}error:${C_RESET} $*" >&2; }
warn()  { echo "${C_YELLOW}warn:${C_RESET}  $*" >&2; }
info()  { echo "${C_BLUE}info:${C_RESET}  $*"; }
ok()    { echo "${C_GREEN}ok:${C_RESET}    $*"; }

usage() {
  cat <<EOF
${C_BOLD}homebase${C_RESET} — distribution CLI for your governance source of truth.

${C_BOLD}Usage:${C_RESET}
  homebase <verb> [args]

${C_BOLD}Verbs:${C_RESET}
  link                         Symlink ~/.claude/{agents,skills,statusline-command.sh,agent-signal.sh,settings.json} → homebase
  link-project <project-path>  Create project-level symlinks (hooks, scripts, settings)
  migrate <project-path>       Idempotent: replace vendored copies with symlinks
  status <project-path>        Verify every expected symlink points to homebase
  bootstrap                    First-run on a new machine: link + walk every project (SOP-014)
  sync <project-path>          DEPRECATED — use link-project or migrate
  register <project-path>      Add a project to the registry (no symlinks; scaffolds project.yml)
  index [--check]              Regenerate registry/PROJECTS.md from each project's project.yml
  list                         Print registry/PROJECTS.md to stdout
  deploy <app> <env> [opts]    Deploy an app via Kamal (12-phase pipeline)
  rollback <app> <env> [opts]  Roll back an app to a previous version
  env <app> <env> [opts]       Inspect env vars injected into the deployed container
  console <app> <env> [opts]   Open an interactive session against a deployed app
  roadmap <sub> [opts]         SOP-013 roadmap ops (bootstrap/capture/render/audit/portfolio/org/team/project)
  work <sub> [args]            Workflow control plane (start/checkpoint/finish/status/cancel/resume/init/ship)
  settings <sub> [args]        Portable user-level Claude Code settings (doctor)
  render-claudemd <path>       Re-render marker-delimited regions of <project>/CLAUDE.md from workflow.yml
  protect <path> [opts]        Assert canonical GitHub branch protection on main (--check / --apply)
  roster                       List agents in the staff roster
  sops                         List canonical SOPs
  help                         Show this help

${C_BOLD}Homebase root:${C_RESET} $HOMEBASE
EOF
}

# ── Symlink manifest ───────────────────────────────────────────────────────────
#
# Each line: <source-relative-to-homebase>|<target-relative-to-project>
# The project target is created as a symlink pointing at the homebase source.

SYMLINK_MANIFEST=$(cat <<'EOF'
.claude/settings.json|.claude/settings.json
.githooks/commit-msg|.githooks/commit-msg
scripts/hooks/commit-sop-check.sh|scripts/hooks/commit-sop-check.sh
scripts/hooks/commit-changelog-check.sh|scripts/hooks/commit-changelog-check.sh
scripts/hooks/claude-precommit.sh|scripts/hooks/claude-precommit.sh
scripts/hooks/edit-main-checkout-guard.sh|scripts/hooks/edit-main-checkout-guard.sh
scripts/hooks/gh-cli-guard-hook.sh|scripts/hooks/gh-cli-guard-hook.sh
scripts/hooks/linear-cli-guard-hook.sh|scripts/hooks/linear-cli-guard-hook.sh
scripts/hooks/session-start.sh|scripts/hooks/session-start.sh
scripts/hooks/session-end-cleanup.sh|scripts/hooks/session-end-cleanup.sh
scripts/hooks/task-created.sh|scripts/hooks/task-created.sh
scripts/hooks/task-completed.sh|scripts/hooks/task-completed.sh
scripts/hooks/teammate-idle.sh|scripts/hooks/teammate-idle.sh
scripts/hooks/ui-verification-check.sh|scripts/hooks/ui-verification-check.sh
scripts/lib/gh-api-helper.sh|scripts/lib/gh-api-helper.sh
scripts/lib/issue-trailer.sh|scripts/lib/issue-trailer.sh
scripts/lib/linear-api-helper.sh|scripts/lib/linear-api-helper.sh
scripts/lib/ui-pattern.sh|scripts/lib/ui-pattern.sh
scripts/lib/ac-regex.sh|scripts/lib/ac-regex.sh
scripts/roadmap/audit.sh|scripts/roadmap/audit.sh
scripts/roadmap/bootstrap.sh|scripts/roadmap/bootstrap.sh
scripts/roadmap/capture.sh|scripts/roadmap/capture.sh
scripts/roadmap/linear.rb|scripts/roadmap/linear.rb
scripts/roadmap/portfolio.sh|scripts/roadmap/portfolio.sh
scripts/roadmap/render.sh|scripts/roadmap/render.sh
scripts/validate-docs.sh|scripts/validate-docs.sh
scripts/extract-changelog.sh|scripts/extract-changelog.sh
scripts/android/screencap-verify.sh|scripts/android/screencap-verify.sh
scripts/hooks/work-cli-guard-hook.sh|scripts/hooks/work-cli-guard-hook.sh
scripts/hooks/pre-push.sh|scripts/hooks/pre-push.sh
scripts/hooks/xcodebuild-cli-guard-hook.sh|scripts/hooks/xcodebuild-cli-guard-hook.sh
.githooks/pre-push|.githooks/pre-push
EOF
)

each_manifest_entry() {
  # Calls $1 with (src_rel, dst_rel) for each entry.
  local fn="$1"
  while IFS='|' read -r src dst; do
    [[ -z "$src" ]] && continue
    "$fn" "$src" "$dst"
  done <<< "$SYMLINK_MANIFEST"
}

# ── link (user-level) ──────────────────────────────────────────────────────────

cmd_link() {
  local user_claude="$HOME/.claude"
  mkdir -p "$user_claude"

  link_one_user() {
    local name="$1"
    local src="$HOMEBASE/$name"
    local dst="$user_claude/$name"

    if [[ ! -d "$src" ]]; then
      warn "skipping $name: source does not exist at $src"
      return
    fi

    if [[ -L "$dst" ]]; then
      local current
      current=$(readlink "$dst")
      if [[ "$current" == "$src" ]]; then
        ok "$dst already linked → $src"
        return
      else
        warn "$dst is a symlink to $current (not $src). Remove manually first."
        return 1
      fi
    fi

    if [[ -e "$dst" ]]; then
      warn "$dst already exists and is not a symlink. Merge its contents into $src first, then remove $dst and re-run 'homebase link'."
      return 1
    fi

    ln -s "$src" "$dst"
    ok "linked $dst → $src"
  }

  link_one_user "agents"

  # skills: the user may already have non-homebase skills under ~/.claude/skills
  # (plugin-installed, personal). Symlink each homebase skill individually into
  # that directory rather than clobbering the parent.
  link_subdirs_user "skills"

  # User-level standalone scripts that ~/.claude/settings.json or manual
  # invocations expect to find at ~/.claude/<name>.
  link_one_user_file "scripts/agent-signal.sh" "agent-signal.sh"
  link_one_user_file "scripts/statusline-command.sh" "statusline-command.sh"

  # User-level Claude Code settings (HMB-50). On every machine the file
  # is a real file populated by past sessions on first run; back it up
  # before swapping in the symlink so the operator never loses state.
  BACKUP_EXISTING=1 link_one_user_file ".claude/user-settings.json" "settings.json"
}

# Symlink a single homebase file into ~/.claude/<dst_name>.
# Set BACKUP_EXISTING=1 in the call's env to move any pre-existing real
# file at <dst> aside (to <dst>.bak-<timestamp>) and proceed with the
# symlink. Used for assets that exist as real files on every machine
# before homebase first runs (HMB-50: ~/.claude/settings.json).
link_one_user_file() {
  local src_rel="$1"
  local dst_name="$2"
  local src="$HOMEBASE/$src_rel"
  local dst="$HOME/.claude/$dst_name"

  if [[ ! -f "$src" ]]; then
    warn "skipping $dst_name: source does not exist at $src"
    return
  fi

  if [[ -L "$dst" ]]; then
    local current
    current=$(readlink "$dst")
    if [[ "$current" == "$src" ]]; then
      ok "$dst already linked → $src"
      return
    else
      warn "$dst is a symlink to $current (not $src). Remove manually first."
      return 1
    fi
  fi

  if [[ -e "$dst" ]]; then
    if [[ "${BACKUP_EXISTING:-0}" == "1" ]]; then
      local backup
      backup="${dst}.bak-$(date +%Y%m%d-%H%M%S)"
      mv "$dst" "$backup"
      ok "backed up $dst → $backup"
    else
      warn "$dst already exists and is not a symlink. Merge its contents into $src first, then remove $dst and re-run 'homebase link'."
      return 1
    fi
  fi

  ln -s "$src" "$dst"
  ok "linked $dst → $src"
}

# Symlink every entry in $HOMEBASE/<name>/ into ~/.claude/<name>/<entry>
# without replacing the parent directory.
link_subdirs_user() {
  local name="$1"
  local src_dir="$HOMEBASE/$name"
  local dst_dir="$HOME/.claude/$name"

  if [[ ! -d "$src_dir" ]]; then
    warn "skipping $name: source does not exist at $src_dir"
    return
  fi

  mkdir -p "$dst_dir"

  for entry in "$src_dir"/*; do
    [[ -e "$entry" ]] || continue
    local base
    base=$(basename "$entry")
    local dst="$dst_dir/$base"

    if [[ -L "$dst" ]]; then
      local current
      current=$(readlink "$dst")
      if [[ "$current" == "$entry" ]]; then
        ok "$dst already linked → $entry"
        continue
      else
        warn "$dst is a symlink to $current (not $entry). Remove manually first."
        continue
      fi
    fi

    if [[ -e "$dst" ]]; then
      warn "$dst already exists and is not a symlink — skipping ($name: $base). Remove manually to re-link to homebase."
      continue
    fi

    ln -s "$entry" "$dst"
    ok "linked $dst → $entry"
  done
}

# ── Shared: create one project-level symlink ───────────────────────────────────
#
# Args: <src_rel> <dst_rel> <force-flag>
# force=1 replaces a pre-existing real file at dst; force=0 bails on conflict.

link_one_project() {
  local src_rel="$1"
  local dst_rel="$2"
  local project="$3"
  local force="${4:-0}"

  local src="$HOMEBASE/$src_rel"
  local dst="$project/$dst_rel"

  if [[ ! -e "$src" ]]; then
    warn "source missing: $src (skipping $dst_rel)"
    return
  fi

  mkdir -p "$(dirname "$dst")"

  if [[ -L "$dst" ]]; then
    local current
    current=$(readlink "$dst")
    if [[ "$current" == "$src" ]]; then
      info "  already linked: $dst_rel"
      return
    else
      warn "  $dst_rel is a symlink to $current — replacing."
      rm -f "$dst"
    fi
  elif [[ -e "$dst" ]]; then
    if [[ "$force" == "1" ]]; then
      warn "  $dst_rel exists as a file — replacing with symlink (migrate mode)."
      rm -f "$dst"
    else
      err "  $dst_rel exists and is not a symlink. Run 'homebase migrate $project' to replace vendored copies."
      return 1
    fi
  fi

  ln -s "$src" "$dst"
  ok "  linked: $dst_rel → $src_rel"
}

# ── link-project ───────────────────────────────────────────────────────────────

cmd_link_project() {
  local project="${1:-}"
  [[ -z "$project" ]] && { err "usage: homebase link-project <project-path>"; return 2; }
  [[ ! -d "$project" ]] && { err "not a directory: $project"; return 2; }
  project="$(cd "$project" && pwd)"

  info "linking homebase → $project"

  each_manifest_entry_link() {
    link_one_project "$1" "$2" "$project" 0
  }
  # Re-declare each_manifest_entry with closure-captured project.
  while IFS='|' read -r src dst; do
    [[ -z "$src" ]] && continue
    link_one_project "$src" "$dst" "$project" 0
  done <<< "$SYMLINK_MANIFEST"

  ensure_core_hookspath "$project"
  ensure_worktrees_gitignored "$project"
  write_manifest "$project"
  register_project "$project"
  scaffold_project_yml "$project"
  run_index_quiet
}

# ── migrate ────────────────────────────────────────────────────────────────────

cmd_migrate() {
  local project="${1:-}"
  [[ -z "$project" ]] && { err "usage: homebase migrate <project-path>"; return 2; }
  [[ ! -d "$project" ]] && { err "not a directory: $project"; return 2; }
  project="$(cd "$project" && pwd)"

  info "migrating $project to symlinks"

  # 1. Un-gitignore .claude/settings.local.json if it's currently ignored.
  local gitignore="$project/.gitignore"
  if [[ -f "$gitignore" ]] && grep -qE '^(\.claude/|\.claude/\*|\.claude/settings\.local\.json)' "$gitignore"; then
    if ! grep -qxF '!.claude/settings.local.json' "$gitignore"; then
      info "  un-gitignoring .claude/settings.local.json"
      # Append a negation rule (overrides preceding .claude/ ignores).
      printf '\n# Committed: project-specific overlay for symlinked canonical settings.json\n!.claude/settings.local.json\n' >> "$gitignore"
      ok "  appended !.claude/settings.local.json to .gitignore"
    else
      info "  .claude/settings.local.json already un-ignored"
    fi
  fi

  # 2. Replace each vendored/real file with a symlink.
  while IFS='|' read -r src dst; do
    [[ -z "$src" ]] && continue
    link_one_project "$src" "$dst" "$project" 1
  done <<< "$SYMLINK_MANIFEST"

  ensure_core_hookspath "$project"
  ensure_worktrees_gitignored "$project"
  write_manifest "$project"
  register_project "$project"
  scaffold_project_yml "$project"
  run_index_quiet
}

# ── Shared helpers ─────────────────────────────────────────────────────────────

ensure_core_hookspath() {
  local project="$1"
  if [[ -d "$project/.git" ]] || git -C "$project" rev-parse --git-dir >/dev/null 2>&1; then
    local current_hooks
    current_hooks=$(git -C "$project" config --get core.hooksPath 2>/dev/null || echo "")
    if [[ "$current_hooks" != ".githooks" ]]; then
      git -C "$project" config core.hooksPath .githooks
      ok "  set core.hooksPath=.githooks in $project"
    else
      info "  core.hooksPath already .githooks"
    fi
  fi
}

# Ensure `.worktrees/` is gitignored when the project opts into HMB-27
# worktree mode. No-op when project.yml is absent or worktree.enabled is
# false. Idempotent: appends the rule once if missing.
ensure_worktrees_gitignored() {
  local project="$1"
  local project_yml="$project/.homebase/project.yml"
  [[ ! -f "$project_yml" ]] && return 0

  # Cheap YAML poke without depending on the full jq+ruby pipeline at
  # link-time. Walk the worktree: block and look for `enabled: true`.
  awk '
    /^[[:space:]]*worktree:/ { in_block = 1; next }
    in_block && /^[a-zA-Z]/ { in_block = 0 }
    in_block && /^[[:space:]]+enabled:[[:space:]]+true/ { print "yes"; exit 0 }
  ' "$project_yml" | grep -q yes || return 0

  local gitignore="$project/.gitignore"
  if [[ -f "$gitignore" ]] && grep -qxF '.worktrees/' "$gitignore"; then
    info "  .worktrees/ already in .gitignore"
    return 0
  fi
  printf '\n# Per-task git worktrees managed by homebase work (HMB-27)\n.worktrees/\n' >> "$gitignore"
  ok "  appended .worktrees/ to .gitignore"
}

write_manifest() {
  local project="$1"
  local sha
  sha=$(git -C "$HOMEBASE" rev-parse --short HEAD 2>/dev/null || echo "unknown")
  mkdir -p "$project/.homebase"
  {
    echo "{"
    echo "  \"homebase_sha\": \"$sha\","
    echo "  \"linked_at\": \"$(date -u +%Y-%m-%dT%H:%M:%SZ)\","
    echo "  \"mode\": \"symlink\","
    echo "  \"linked_files\": ["
    local first=1
    while IFS='|' read -r src dst; do
      [[ -z "$src" ]] && continue
      if [[ $first -eq 1 ]]; then
        first=0
      else
        echo ","
      fi
      printf '    "%s"' "$dst"
    done <<< "$SYMLINK_MANIFEST"
    echo ""
    echo "  ]"
    echo "}"
  } > "$project/.homebase/manifest.json"
  ok "  wrote $project/.homebase/manifest.json (homebase_sha=$sha)"
}

# ── status ─────────────────────────────────────────────────────────────────────

# HMB-88: stray worktree advisory. Flag worktrees with no commits beyond base
# AND no state file — safe-to-remove leftovers (e.g. a worktree that `finish`
# retained because it couldn't delete its own CWD under a live session;
# HMB-109). Worktrees with commits or an active/finished state are legitimate
# in-flight work; we just count them so they're visible.
_report_stray_worktrees() {
  local project="$1"
  local strays=0
  local in_flight=0
  git -C "$project" rev-parse --git-dir >/dev/null 2>&1 || return 0
  local base
  base="$(grep -E "^[[:space:]]+base:[[:space:]]+" "$project/.homebase/workflow.yml" 2>/dev/null | head -1 | awk -F: '{gsub(/^ +| +$/, "", $2); print $2}')"
  [[ -z "$base" ]] && base="main"
  local stray_lines=""
  while IFS=$'\t' read -r wt_path wt_branch; do
    [[ -z "$wt_path" ]] && continue
    # Skip the main checkout itself. Compare canonical forms because
    # `git worktree list` emits `/private/var/...` on macOS while $project
    # may be `/var/...` (or vice-versa) depending on how the caller passed
    # the path.
    local wt_canon project_canon
    wt_canon="$(cd "$wt_path" 2>/dev/null && pwd -P)"
    project_canon="$(cd "$project" 2>/dev/null && pwd -P)"
    [[ "$wt_canon" == "$project_canon" ]] && continue
    local wt_commits sha state_file
    wt_commits="$(git -C "$project" rev-list "$wt_branch" "^$base" 2>/dev/null | wc -l | tr -d ' ')"
    sha="$(printf '%s' "$wt_canon" | shasum | cut -c1-8)"
    state_file="$project/.homebase/work-state.$sha.json"
    if [[ "$wt_commits" -eq 0 && ! -f "$state_file" ]]; then
      strays=$((strays + 1))
      stray_lines+="    ${C_YELLOW}stray${C_RESET}     ${wt_path#$project/} (branch $wt_branch — no commits, no state; safe to remove)"$'\n'
    else
      in_flight=$((in_flight + 1))
    fi
  done < <(git -C "$project" worktree list --porcelain 2>/dev/null | awk '
    /^worktree / { wt=$2 }
    /^branch / { br=$2; sub(/^refs\/heads\//, "", br) }
    /^$/ { if (wt != "") print wt "\t" br; wt=""; br="" }
    END { if (wt != "") print wt "\t" br }')
  if [[ "$strays" -gt 0 ]]; then
    echo "  ${C_YELLOW}worktrees${C_RESET}: $strays stray (safe to remove), $in_flight in-flight"
    printf '%b' "$stray_lines"
    echo "    ${C_YELLOW}└─${C_RESET} clean up via 'git -C $project worktree remove --force <path> && git -C $project branch -D <branch>'"
  elif [[ "$in_flight" -gt 0 ]]; then
    echo "  ${C_GREEN}worktrees${C_RESET}: $in_flight in-flight (no strays)"
  fi
}

cmd_status() {
  local project="${1:-}"
  [[ -z "$project" ]] && { err "usage: homebase status <project-path>"; return 2; }
  [[ ! -d "$project" ]] && { err "not a directory: $project"; return 2; }
  project="$(cd "$project" && pwd)"

  info "status: $project vs $HOMEBASE"

  # HMB-63: homebase IS the source-of-truth. The files at the
  # SYMLINK_MANIFEST destination paths are real source files, not
  # symlinks pointing back at themselves. Running the regular check
  # against the canonical homebase clone produces N false-positive
  # "vendored copy" entries and returns rc=1, which then trips
  # bootstrap's Step 4 `[FAIL] linked but status dirty`. Detect via
  # `git worktree list` — the first entry is always the main worktree
  # (the canonical homebase clone), regardless of whether bin/homebase
  # was invoked from a worktree or from main.
  local main_homebase
  main_homebase=$(git -C "$HOMEBASE" worktree list --porcelain 2>/dev/null | awk '/^worktree/{print $2; exit}')
  if [[ -n "$main_homebase" && "$project" -ef "$main_homebase" ]]; then
    ok "source-of-truth checkout (manifest destinations are the canonical files)"
    if [[ -f "$project/.homebase/manifest.json" ]]; then
      local manifest_sha
      manifest_sha=$(grep -o '"homebase_sha": *"[^"]*"' "$project/.homebase/manifest.json" 2>/dev/null | sed 's/.*"\([^"]*\)"$/\1/' || echo "")
      local current_sha
      current_sha=$(git -C "$HOMEBASE" rev-parse --short HEAD 2>/dev/null || echo "unknown")
      echo "  manifest: linked from $manifest_sha, homebase is now $current_sha"
    fi
    # HMB-88: surface stray worktrees on the source-of-truth path too.
    _report_stray_worktrees "$project"
    return 0
  fi

  local broken=0
  local missing=0
  local wrong=0
  local copy=0

  while IFS='|' read -r src_rel dst_rel; do
    [[ -z "$src_rel" ]] && continue
    local src="$HOMEBASE/$src_rel"
    local dst="$project/$dst_rel"

    if [[ ! -e "$dst" ]] && [[ ! -L "$dst" ]]; then
      echo "  ${C_RED}missing${C_RESET}    $dst_rel"
      missing=$((missing + 1))
      continue
    fi

    if [[ -L "$dst" ]]; then
      local current
      current=$(readlink "$dst")
      if [[ "$current" == "$src" ]]; then
        # Symlink target exists?
        if [[ -e "$dst" ]]; then
          echo "  ${C_GREEN}linked${C_RESET}     $dst_rel"
        else
          echo "  ${C_RED}broken${C_RESET}     $dst_rel → $current (target missing)"
          broken=$((broken + 1))
        fi
      else
        echo "  ${C_YELLOW}wrong${C_RESET}      $dst_rel → $current (expected $src)"
        wrong=$((wrong + 1))
      fi
    else
      echo "  ${C_YELLOW}copy${C_RESET}       $dst_rel (vendored copy — run 'homebase migrate')"
      copy=$((copy + 1))
    fi
  done <<< "$SYMLINK_MANIFEST"

  echo
  if [[ -f "$project/.homebase/manifest.json" ]]; then
    local manifest_sha
    manifest_sha=$(grep -o '"homebase_sha": *"[^"]*"' "$project/.homebase/manifest.json" 2>/dev/null | sed 's/.*"\([^"]*\)"$/\1/' || echo "")
    local current_sha
    current_sha=$(git -C "$HOMEBASE" rev-parse --short HEAD 2>/dev/null || echo "unknown")
    echo "  manifest: linked from $manifest_sha, homebase is now $current_sha"
  else
    echo "  ${C_YELLOW}no .homebase/manifest.json${C_RESET} — run 'homebase link-project $project'"
  fi

  # Branch protection check (advisory; doesn't fail status overall on drift).
  # Operators can run `homebase protect <project> --check` for the full
  # report or `--apply` (TPM-only) to fix drift.
  if [[ -f "$project/.homebase/project.yml" ]]; then
    local has_github_repos
    has_github_repos=$(jq_or_grep_apps_github "$project")
    if [[ -n "$has_github_repos" ]]; then
      if "$HOMEBASE/scripts/protect.sh" "$project" --check >/dev/null 2>&1; then
        echo "  ${C_GREEN}branch protection${C_RESET}: aligned"
      else
        echo "  ${C_YELLOW}branch protection${C_RESET}: drift — run 'homebase protect $project --check' for details"
      fi
    fi
  fi

  # HMB-88: stray worktree advisory shared with the source-of-truth path.
  _report_stray_worktrees "$project"

  echo
  if [[ $missing -eq 0 && $broken -eq 0 && $wrong -eq 0 && $copy -eq 0 ]]; then
    ok "clean"
    return 0
  fi
  err "$missing missing, $broken broken, $wrong wrong target, $copy vendored copies"
  return 1
}

# Returns non-empty stdout if the project's project.yml declares any
# apps[].github entries. Used by cmd_status to skip the branch-protection
# check for projects without GitHub repos declared.
jq_or_grep_apps_github() {
  local proj="$1"
  if command -v jq >/dev/null 2>&1 && command -v ruby >/dev/null 2>&1; then
    ruby -ryaml -rjson -e 'puts JSON.generate(YAML.load_file(ARGV[0]))' "$proj/.homebase/project.yml" 2>/dev/null \
      | jq -r '(.apps // []) | map(.github // empty) | first // empty'
  else
    grep -E '^\s+github:' "$proj/.homebase/project.yml" 2>/dev/null | head -1
  fi
}

# ── sync (deprecated) ──────────────────────────────────────────────────────────

cmd_sync() {
  err "'sync' is deprecated. Homebase no longer vendors copies into projects."
  cat >&2 <<EOF

Replacements:

  homebase link-project <project>     — create symlinks for a fresh project
  homebase migrate <project>          — idempotent: replace vendored copies with symlinks

To migrate an existing vendored project, run:

  homebase migrate "${1:-<project-path>}"

EOF
  return 2
}

# ── roster ─────────────────────────────────────────────────────────────────────

cmd_roster() {
  if [[ ! -d "$HOMEBASE/agents" ]]; then
    warn "no agents/ directory in $HOMEBASE"
    return 1
  fi

  echo "${C_BOLD}Homebase staff roster:${C_RESET}"
  for f in "$HOMEBASE"/agents/*.md; do
    [[ ! -f "$f" ]] && continue
    local name
    name=$(basename "$f" .md)
    local desc
    desc=$(awk -F': ' '/^description: /{gsub(/^"|"$/, "", $2); print $2; exit}' "$f")
    printf "  %-32s  %s\n" "$name" "$desc"
  done
}

# ── sops ──────────────────────────────────────────────────────────────────────

cmd_sops() {
  if [[ ! -d "$HOMEBASE/sops" ]]; then
    warn "no sops/ directory in $HOMEBASE"
    return 1
  fi

  echo "${C_BOLD}Canonical SOPs:${C_RESET}"
  for f in "$HOMEBASE"/sops/HOMEBASE-SOP-*.md; do
    [[ ! -f "$f" ]] && continue
    local name
    name=$(basename "$f" .md)
    local title
    title=$(awk '/^# /{sub(/^# /, ""); print; exit}' "$f")
    printf "  %-52s  %s\n" "$name" "$title"
  done
}

# ── registry: scaffold / register / index / list ───────────────────────────────

PATHS_FILE="$HOMEBASE/registry/projects.paths"
REGISTRY_FILE="$HOMEBASE/registry/PROJECTS.md"
RENDERER="$HOMEBASE/scripts/lib/render-registry.rb"
PROJECT_YML_TEMPLATE="$HOMEBASE/templates/project.yml.tmpl"

# Copy the template into the project if .homebase/project.yml is missing.
# Prefills the `name:` line with the project's directory basename.
scaffold_project_yml() {
  local project="$1"
  local dst="$project/.homebase/project.yml"
  [[ -f "$dst" ]] && { info "  .homebase/project.yml already present"; return 0; }

  if [[ ! -f "$PROJECT_YML_TEMPLATE" ]]; then
    warn "  no project.yml template at $PROJECT_YML_TEMPLATE"
    return 0
  fi

  local base
  base="$(basename "$project")"
  mkdir -p "$project/.homebase"
  sed "s/^name: PROJECT_NAME$/name: $base/" "$PROJECT_YML_TEMPLATE" > "$dst"
  ok "  scaffolded $dst (fill in apps[] and run 'homebase index')"
  warn "  registry for '$base' is incomplete until you fill in $dst"
}

# Append $project's absolute path to registry/projects.paths if not already present.
register_project() {
  local project="$1"
  mkdir -p "$HOMEBASE/registry"
  touch "$PATHS_FILE"

  if grep -qxF "$project" "$PATHS_FILE" 2>/dev/null; then
    info "  already registered: $project"
    return 0
  fi

  # Append, then sort and dedupe in place.
  printf '%s\n' "$project" >> "$PATHS_FILE"
  LC_ALL=C sort -u "$PATHS_FILE" -o "$PATHS_FILE"
  ok "  registered in $PATHS_FILE"
}

run_index_quiet() {
  cmd_index >/dev/null 2>&1 || warn "  'homebase index' failed — run it manually to diagnose"
}

cmd_register() {
  local project="${1:-}"
  [[ -z "$project" ]] && { err "usage: homebase register <project-path>"; return 2; }
  [[ ! -d "$project" ]] && { err "not a directory: $project"; return 2; }
  project="$(cd "$project" && pwd)"

  info "registering $project with homebase"
  register_project "$project"
  scaffold_project_yml "$project"
  cmd_index
}

cmd_index() {
  local mode="${1:-}"

  if [[ ! -x "$RENDERER" ]]; then
    err "missing renderer at $RENDERER"
    return 2
  fi
  if [[ ! -f "$PATHS_FILE" ]]; then
    err "no registry: $PATHS_FILE does not exist — run 'homebase register <project>' or 'homebase link-project <project>'"
    return 2
  fi
  if ! command -v ruby >/dev/null 2>&1; then
    err "ruby not found on PATH — required for registry rendering"
    return 2
  fi

  local tmp
  tmp="$(mktemp -t homebase-registry.XXXXXX)"
  if ! ruby "$RENDERER" "$HOMEBASE" > "$tmp"; then
    local rc=$?
    rm -f "$tmp"
    if [[ $rc -eq 1 ]]; then
      err "one or more projects are missing .homebase/project.yml — see warnings above"
    fi
    return "$rc"
  fi

  if [[ "$mode" == "--check" ]]; then
    if [[ -f "$REGISTRY_FILE" ]] && diff -q "$REGISTRY_FILE" "$tmp" >/dev/null 2>&1; then
      rm -f "$tmp"
      ok "registry up to date"
      return 0
    fi
    err "registry drift — run 'homebase index' and commit the diff"
    if [[ -f "$REGISTRY_FILE" ]]; then
      diff -u "$REGISTRY_FILE" "$tmp" >&2 || true
    fi
    rm -f "$tmp"
    return 1
  fi

  mkdir -p "$(dirname "$REGISTRY_FILE")"
  mv "$tmp" "$REGISTRY_FILE"
  local lines
  lines="$(wc -l < "$REGISTRY_FILE" | tr -d ' ')"
  local projects
  projects="$(grep -cvE '^(#|$)' "$PATHS_FILE" || true)"
  ok "wrote $REGISTRY_FILE ($lines lines, $projects projects)"
}

cmd_list() {
  if [[ ! -f "$REGISTRY_FILE" ]]; then
    err "no registry — run 'homebase index' first"
    return 1
  fi
  cat "$REGISTRY_FILE"
}

